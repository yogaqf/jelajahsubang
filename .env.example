# Neon Database Connection String
# Example: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Public production origin used for canonical URLs and article sharing
SITE_URL="https://jelajahsubang.com"

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin login (password must be at least 10 characters)
ADMIN_EMAIL="admin@jelajahsubang.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
